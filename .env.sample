# Copy to .env and fill in. .env is gitignored - never commit real values.
#
# Secrets can be injected at runtime instead of living on disk, e.g. with the
# 1Password CLI:  op run --env-file=.env.op -- python -m src.audio.transcription

# --- CMU SSO, for the Panopto ingestion step (laptop only) -------------------
# Only the Andrew ID is needed: ingestion.py opens a browser and you complete
# SSO + Duo by hand. There is deliberately no password here.
SSO_ID=your_andrew_id

# --- HuggingFace, for pyannote speaker diarization --------------------------
# You must ALSO accept the model conditions on the HF website for both:
#   pyannote/speaker-diarization-3.1
#   pyannote/speaker-diarization-community-1   (3.1 pulls PLDA files from it)
# Otherwise transcription fails with a 403.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Anthropic, for question classification + caption polishing -------------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# --- PSC Bridges-2 access (non-secret; used by scripts/psc.sh) --------------
# No password or token belongs here: psc.sh uses SSH connection multiplexing,
# so you authenticate once interactively and nothing is stored.
# Your PSC password is a Kerberos password, separate from CMU SSO.
PSC_HOST=bridges2.psc.edu
PSC_DTN_HOST=data.bridges2.psc.edu
PSC_USER=your_psc_username
PSC_SSH_ALIAS=psc
PSC_CONDA_ENV=scs-learn
# Prefer /ocean over /jet/home: home is 25GB and typically near full.
PSC_REMOTE_REPO=/ocean/projects/cis260220p/your_psc_username/scs-learn-video-pipeline
